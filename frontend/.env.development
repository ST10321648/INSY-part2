# --------------------------------------------------
# FRONTEND ENV CONFIG – LOCAL DEVELOPMENT
# --------------------------------------------------

# Run the React dev server over plain HTTP
HTTPS=false

# Tell React where the backend API lives
REACT_APP_API_BASE=http://localhost:5000

# Optional – show full React error overlays in dev
FAST_REFRESH=true

# Optional – if your backend uses cookies for auth (it does)
# React must send them along with requests
REACT_APP_WITH_CREDENTIALS=true

# Optional – port for the React dev server
# (defaults to 3000 if not set)
PORT=3001

# Allow your React dev origin (check your actual port: 3000 or 3001)
CORS_ORIGIN=http://localhost:3001